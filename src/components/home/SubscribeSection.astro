---
---

<section class="subscribe-section section" id="updates">
  <div class="container">
    <div class="subscribe-grid">
      <div class="subscribe-content">
        <h3 class="subscribe-title">Receive Updates</h3>
        <p class="subscribe-description">
          Email notifications about our work. No spam. Just signal.
        </p>
        <p class="subscribe-note">
          <small>Also on <a href="https://phronos.substack.com" target="_blank" rel="noopener">Substack</a></small>
        </p>
      </div>
      <div class="subscribe-form-container">
        <form id="subscribe-form" class="subscribe-form">
          <input
            type="email"
            name="email"
            placeholder="email"
            required
            autocomplete="email"
            class="subscribe-input"
          />
          <button type="submit" class="subscribe-button" aria-label="Subscribe">
            <span class="subscribe-button-text">&rarr;</span>
            <span class="subscribe-button-loading" aria-hidden="true"></span>
          </button>
        </form>
        <p id="subscribe-message" class="subscribe-message" aria-live="polite"></p>
      </div>
    </div>
  </div>
</section>

<script>
  function initSubscribeForm() {
    const form = document.getElementById('subscribe-form') as HTMLFormElement | null;
    const messageEl = document.getElementById('subscribe-message');
    const button = form?.querySelector('.subscribe-button') as HTMLButtonElement | null;

    if (!form || !messageEl || !button) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const email = formData.get('email') as string;

      // Set loading state
      button.disabled = true;
      form.classList.add('is-loading');
      messageEl.textContent = '';
      messageEl.className = 'subscribe-message';

      try {
        const response = await fetch('https://instruments.phronos.org/api/v1/mailing/subscribe', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ email, source: 'website' }),
        });

        const data = await response.json();

        if (response.ok && data.success) {
          messageEl.textContent = data.message;
          messageEl.classList.add('is-success');
          form.reset();
        } else {
          const errorMsg = data.detail?.error || data.error || 'Something went wrong. Please try again.';
          messageEl.textContent = errorMsg;
          messageEl.classList.add('is-error');
        }
      } catch (error) {
        messageEl.textContent = 'Network error. Please try again.';
        messageEl.classList.add('is-error');
      } finally {
        button.disabled = false;
        form.classList.remove('is-loading');
      }
    });
  }

  initSubscribeForm();
  document.addEventListener('astro:after-swap', initSubscribeForm);
</script>

<style>
  .subscribe-section {
    /* No border-top here - section header provides the line */
  }

  .subscribe-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .subscribe-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--ink);
    margin-bottom: var(--space-sm);
  }

  .subscribe-description {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    color: var(--ink);
    line-height: 1.6;
    margin-bottom: var(--space-sm);
  }

  .subscribe-note {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--faded);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .subscribe-note a {
    color: var(--faded);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .subscribe-note a:hover {
    color: var(--gold);
  }

  .subscribe-form-container {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-sm);
  }

  .subscribe-form {
    display: flex;
    gap: 0;
    width: 100%;
  }

  .subscribe-input {
    flex: 1;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: var(--space-md) var(--space-md);
    border: 1px solid var(--ink);
    border-right: none;
    background: var(--white);
    color: var(--ink);
    outline: none;
    transition: border-color var(--transition-default);
  }

  .subscribe-input::placeholder {
    color: var(--faded);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .subscribe-input:focus {
    border-color: var(--gold);
  }

  .subscribe-button {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    font-weight: 500;
    color: var(--white);
    background: var(--ink);
    border: 1px solid var(--ink);
    padding: var(--space-md) var(--space-lg);
    cursor: pointer;
    transition: all var(--transition-default);
    position: relative;
  }

  .subscribe-button:hover:not(:disabled) {
    background: var(--gold);
    border-color: var(--gold);
  }

  .subscribe-button:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }

  .subscribe-button-loading {
    display: none;
  }

  .subscribe-form.is-loading .subscribe-button-text {
    visibility: hidden;
  }

  .subscribe-form.is-loading .subscribe-button-loading {
    display: block;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 16px;
    height: 16px;
    border: 2px solid transparent;
    border-top-color: var(--white);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  .subscribe-message {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    min-height: 1.5em;
    text-align: right;
  }

  .subscribe-message.is-success {
    color: var(--gold);
  }

  .subscribe-message.is-error {
    color: #c44;
  }

  @media (max-width: 767px) {
    .subscribe-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .subscribe-form-container {
      align-items: center;
    }

    .subscribe-form {
      max-width: 100%;
    }

    .subscribe-message {
      text-align: center;
    }
  }
</style>

---
// INS-001.2 Common Ground - Hero visualization
// Drives click-through to assessment with placeholder "YOU" row

const baselines = [
  {
    label: 'AI',
    words: ['investigation', 'evidence', 'truth', 'clarity', 'knowledge'],
    fidelity: 34,
    spread: 62,
  },
  {
    label: 'EMBEDDING',
    words: ['assurance', 'doubtless', 'mystique', 'suspense', 'insecurity'],
    fidelity: 36,
    spread: 55,
  },
];
---

<a href="https://instruments.phronos.org/ins-001/ins-001-2/" class="ins-panel-link">
  <div class="ins-panel">
    <!-- Header -->
    <div class="ins-header">
      <span class="ins-id">INS-001.2 — COMMON GROUND</span>
      <span class="ins-live-badge">Live</span>
    </div>

    <!-- Axis header -->
    <div class="ins-axis">
      <span class="ins-axis-label">mystery</span>
      <div class="ins-axis-line">
        <svg width="8" height="10" viewBox="0 0 8 10" class="ins-arrow">
          <polygon points="0,5 6,0 6,10" />
        </svg>
        <div class="ins-axis-dash"></div>
        <svg width="8" height="10" viewBox="0 0 8 10" class="ins-arrow">
          <polygon points="8,5 2,0 2,10" />
        </svg>
      </div>
      <span class="ins-axis-label">certainty</span>
    </div>

    <!-- Legend -->
    <div class="ins-legend">
      <div class="ins-legend-item">
        <div class="ins-legend-dot filled"></div>
        <span>FIDELITY</span>
      </div>
      <div class="ins-legend-item">
        <div class="ins-legend-dot outline"></div>
        <span>SPREAD</span>
      </div>
    </div>

    <!-- Scale -->
    <div class="ins-scale">
      <span>0</span>
      <span>25</span>
      <span>50</span>
      <span>75</span>
      <span>100</span>
    </div>

    <!-- Rows -->
    <div class="ins-rows">
      <!-- YOU row - placeholder state -->
      <div class="ins-row placeholder">
        <div class="ins-row-inner">
          <div class="ins-label-group highlight">
            <div class="ins-accent-bar"></div>
            <span class="ins-label highlight">YOU</span>
          </div>
          <div class="ins-track placeholder-track">
            <div class="ins-connection placeholder-connection"></div>
            <div class="ins-dot placeholder-dot" style="left: 25%;"></div>
            <div class="ins-dot placeholder-dot outline" style="left: 65%;"></div>
            <span class="ins-value" style="left: 25%;">?</span>
            <span class="ins-value" style="left: 65%;">?</span>
          </div>
        </div>
      </div>

      <!-- Baseline rows -->
      {baselines.map((row) => (
        <div class="ins-row">
          <div class="ins-row-inner">
            <div class="ins-label-group">
              <span class="ins-label">{row.label}</span>
            </div>
            <div class="ins-track">
              <div
                class="ins-connection"
                style={`left: ${row.fidelity}%; width: ${row.spread - row.fidelity}%;`}
              ></div>
              <div class="ins-dot filled" style={`left: ${row.fidelity}%;`}></div>
              <div class="ins-dot outline" style={`left: ${row.spread}%;`}></div>
              <span class="ins-value" style={`left: ${row.fidelity}%;`}>{row.fidelity}</span>
              <span class="ins-value" style={`left: ${row.spread}%;`}>{row.spread}</span>
            </div>
          </div>
        </div>
      ))}

      <!-- OTHERS row - calibrating -->
      <div class="ins-row">
        <div class="ins-row-inner">
          <div class="ins-label-group">
            <span class="ins-label">OTHERS</span>
          </div>
          <div class="ins-track calibrating">
            <div class="ins-pulsing-dot">
              <div class="ins-pulse-ring"></div>
              <div class="ins-pulse-core"></div>
            </div>
            <span class="ins-calibrating-text">Calibrating...</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom invitation -->
    <div class="ins-invitation">
      <p>Where do you stand relative to the machine?</p>
    </div>

    <!-- Footer CTA -->
    <div class="ins-cta">
      <span>Begin assessment</span>
      <span class="ins-arrow-right">&rarr;</span>
    </div>
  </div>
</a>

<style>
  .ins-panel-link {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform var(--transition-default);
  }

  .ins-panel-link:hover {
    transform: translate(-2px, -2px);
  }

  .ins-panel-link:hover .ins-panel {
    box-shadow: 14px 14px 0px rgba(26, 26, 26, 0.1);
  }

  .ins-panel-link:hover .ins-cta {
    color: var(--ink);
  }

  .ins-panel {
    background: var(--white);
    border: 1px solid var(--ink);
    padding: 1.5rem;
    box-shadow: 12px 12px 0px rgba(26, 26, 26, 0.05);
    max-width: 420px;
    transition: box-shadow var(--transition-default);
  }

  /* Header */
  .ins-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.75rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--faded-light);
  }

  .ins-id {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--faded);
    letter-spacing: 0.5px;
  }

  .ins-live-badge {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--success);
    border: 1px solid var(--success);
    padding: 2px 6px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Axis */
  .ins-axis {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    padding-left: 5.5rem;
  }

  .ins-axis-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink);
  }

  .ins-axis-line {
    display: flex;
    align-items: center;
  }

  .ins-arrow {
    fill: var(--ink);
  }

  .ins-axis-dash {
    width: 4rem;
    margin: 0 0.25rem;
    border-top: 1px dashed var(--faded);
  }

  /* Legend */
  .ins-legend {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 0.5rem;
    padding-left: 5.5rem;
  }

  .ins-legend-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--faded);
  }

  .ins-legend-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .ins-legend-dot.filled {
    background: var(--gold);
  }

  .ins-legend-dot.outline {
    border: 1.5px solid var(--gold);
    background: transparent;
  }

  /* Scale */
  .ins-scale {
    display: flex;
    justify-content: space-between;
    padding-left: 5.5rem;
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--faded);
  }

  /* Rows */
  .ins-rows {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .ins-row {
    position: relative;
  }

  .ins-row-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .ins-label-group {
    width: 5rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .ins-label-group.highlight {
    gap: 0.35rem;
  }

  .ins-accent-bar {
    width: 3px;
    height: 14px;
    background: var(--gold);
    border-radius: 1px;
  }

  .ins-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: 0.5px;
  }

  .ins-label.highlight {
    color: var(--gold);
  }

  /* Track */
  .ins-track {
    flex: 1;
    height: 16px;
    position: relative;
    background: #F0EEE6;
    border: 1px solid var(--faded-light);
    border-radius: 2px;
  }

  .ins-track.placeholder-track {
    background: #F5F0E6;
    border: 1px dashed var(--gold);
  }

  .ins-track.calibrating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .ins-connection {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    height: 2px;
    background: var(--gold);
  }

  .ins-connection.placeholder-connection {
    left: 25%;
    width: 40%;
    border-top: 2px dashed var(--gold);
    background: transparent;
    height: 0;
    opacity: 0.5;
  }

  .ins-dot {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    transition: transform 0.15s ease;
  }

  .ins-dot.filled {
    background: var(--gold);
  }

  .ins-dot.outline {
    background: transparent;
    border: 2px solid var(--gold);
  }

  .ins-dot.placeholder-dot {
    opacity: 0.5;
    border: 2px dashed var(--gold);
    background: transparent;
  }

  .ins-row:hover .ins-dot {
    transform: translate(-50%, -50%) scale(1.2);
  }

  .ins-value {
    position: absolute;
    top: calc(100% + 4px);
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    color: var(--faded);
  }

  /* Pulsing dot for calibrating */
  .ins-pulsing-dot {
    position: relative;
    width: 10px;
    height: 10px;
  }

  .ins-pulse-ring {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--gold);
    opacity: 0.4;
    animation: pulse-ring 2s ease-out infinite;
  }

  .ins-pulse-core {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--gold);
  }

  @keyframes pulse-ring {
    0% {
      transform: scale(1);
      opacity: 0.4;
    }
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .ins-calibrating-text {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--faded);
  }

  /* Invitation */
  .ins-invitation {
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--faded-light);
  }

  .ins-invitation p {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-style: italic;
    color: var(--ink);
    margin: 0;
    line-height: 1.4;
  }

  /* CTA */
  .ins-cta {
    margin-top: 0.75rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--faded-light);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--gold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: color var(--transition-fast);
  }

  .ins-arrow-right {
    font-size: 0.9rem;
  }

  /* Responsive */
  @media (max-width: 767px) {
    .ins-panel {
      max-width: 100%;
      padding: 1.25rem;
    }

    .ins-axis,
    .ins-legend,
    .ins-scale {
      padding-left: 4.5rem;
    }

    .ins-label-group {
      width: 4rem;
    }

    .ins-axis-dash {
      width: 3rem;
    }
  }
</style>

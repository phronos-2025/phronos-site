---
import { getCollection } from 'astro:content';

interface Props {
  dataSource?: string;
  references?: {
    methods?: string[];
    library?: string[];
    instruments?: string[];
  };
  topics?: string[];
}

const { dataSource, references, topics } = Astro.props;

const allRefs = [
  ...(references?.methods || []),
  ...(references?.library || []),
  ...(references?.instruments || [])
].filter(Boolean);

// Look up method URLs
const methodFamilies = await getCollection('methodFamilies');
const methodStudies = await getCollection('methodStudies');

function getMethodUrl(refId: string): string {
  // Check if it's a study (e.g., MTH-001.1)
  const study = methodStudies.find(s => s.data.id.toUpperCase() === refId.toUpperCase());
  if (study) {
    return `/methods/${study.data.family_slug}/${study.data.slug}/`;
  }
  
  // Check if it's a family (e.g., MTH-001)
  const family = methodFamilies.find(f => f.data.id.toUpperCase() === refId.toUpperCase());
  if (family) {
    return `/methods/${family.data.slug}/`;
  }
  
  // Fallback to lowercase ID
  return `/methods/${refId.toLowerCase()}/`;
}
---

<footer class="dispatch-footer">
  <div class="dispatch-footer-grid">
    <div class="dispatch-footer-section">
      <span class="dispatch-footer-label">Data Source</span>
      <span class="dispatch-footer-value">{dataSource || '—'}</span>
    </div>
    
    <div class="dispatch-footer-section">
      <span class="dispatch-footer-label">References</span>
      <span class="dispatch-footer-value">
        {allRefs.length > 0 ? (
          allRefs.map((ref, i) => (
            <>
              <a href={getMethodUrl(ref)}>{ref}</a>
              {i < allRefs.length - 1 && ' · '}
            </>
          ))
        ) : (
          '—'
        )}
      </span>
    </div>
    
    <div class="dispatch-footer-section">
      <span class="dispatch-footer-label">Topics</span>
      <span class="dispatch-footer-value">
        {topics && topics.length > 0 ? topics.join(' · ') : '—'}
      </span>
    </div>
  </div>
</footer>

<style>
  @import '../../styles/components/dispatch.css';
</style>


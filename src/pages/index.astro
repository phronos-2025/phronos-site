---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/global/Nav.astro';
import Footer from '../components/global/Footer.astro';
import SectionHeader from '../components/global/SectionHeader.astro';
import Card from '../components/cards/Card.astro';
import Hero from '../components/home/Hero.astro';
import AboutSection from '../components/home/AboutSection.astro';
import SubscribeSection from '../components/home/SubscribeSection.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import '../styles/components/cards.css';

// Fetch content collections
const dispatches = await getCollection('dispatches', ({ data }) => 
  data.status !== 'archived'
);
const sortedDispatches = dispatches.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const methodFamilies = await getCollection('methodFamilies', ({ data }) => 
  data.status !== 'archived'
);
const sortedMethods = methodFamilies.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Helper to extract first sentence
function getFirstSentence(text: string): string {
  if (!text) return '';
  // If the text doesn't end with sentence-ending punctuation, return it as-is
  // Otherwise, match up to the first sentence-ending punctuation followed by space or capital letter
  if (!/[.!?]/.test(text)) return text;
  // Match sentence ending: period/!/ followed by space and capital letter, or end of string
  const match = text.match(/^[^.!?]+[.!?](?=\s+[A-Z]|$)/);
  return match ? match[0].trim() : text;
}

// Placeholder data for coming soon sections
const libraryItems = [
  { id: 'LIB-002', title: 'Digital Validity', description: 'Under what conditions can chat data serve as valid proxies for cognitive states?', status: 'published' as const, href: 'https://phronos.org/library/digital-validity/' },
];

const instrumentFamilies = [
  {
    id: 'INS-001',
    title: 'Semantic Cartography',
    description: 'Instruments for mapping how you navigate conceptual space—how you encode meaning, transmit it to others, and reconstruct it from sparse signals.',
    status: 'live' as const,
    href: 'https://instruments.phronos.org/ins-001/',
    instruments: [
      { id: 'INS-001.1', title: 'Signal', status: 'live' as const, href: 'https://instruments.phronos.org/ins-001/ins-001-1/' },
      { id: 'INS-001.2', title: 'Common Ground', status: 'live' as const, href: 'https://instruments.phronos.org/ins-001/ins-001-2/' },
    ]
  },
  {
    id: 'INS-002',
    title: 'Reasoning Trace',
    description: 'Observes your problem-solving approach in real-time.',
    status: 'planned' as const,
    instruments: []
  },
];
---

<BaseLayout title="Observatory for Human Cognition">
  <JsonLd schema={{
    type: 'Organization',
    name: 'Phronos',
    url: 'https://phronos.org',
    logo: 'https://phronos.org/favicon.png',
    description: 'An observatory for human cognition in the era of artificial intelligence.'
  }} />
  <Nav slot="nav" />
  
  <Hero />

  <!-- Dispatches Section -->
  <section class="section" id="dispatches">
    <div class="container">
      <SectionHeader id="01" title="Dispatches from the Observatory" />
      <div class="card-grid">
        {sortedDispatches.length > 0 ? (
          sortedDispatches.map((dispatch) => (
            <Card
              id={dispatch.data.id}
              title={dispatch.data.title}
              description={getFirstSentence(dispatch.data.subtitle || '')}
              status={dispatch.data.status}
              version={dispatch.data.version ? `v${dispatch.data.version}` : undefined}
              href={`/dispatches/${dispatch.data.slug}`}
            />
          ))
        ) : (
          <p class="empty-state">First dispatch coming soon.</p>
        )}
      </div>
    </div>
  </section>

  <!-- Library Section -->
  <section class="section" id="library">
    <div class="container">
      <SectionHeader id="02" title="The Library" />
      <div class="card-grid">
        {libraryItems.map((item) => (
          <Card
            id={item.id}
            title={item.title}
            description={item.description}
            status={item.status}
            href={item.href}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Methods Section -->
  <section class="section" id="methods">
    <div class="container">
      <SectionHeader id="03" title="Methods" />
      <div class="card-grid">
        {sortedMethods.map((method) => (
          <Card
            id={method.data.id}
            title={method.data.title}
            description={getFirstSentence(method.data.abstract || '')}
            status={method.data.status}
            version={method.data.version ? `v${method.data.version}` : undefined}
            href={method.data.status === 'published' ? `/methods/${method.data.slug}/` : undefined}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Instruments Section (Dark Mode) -->
  <section class="section instruments-section" id="instruments">
    <div class="container">
      <SectionHeader id="01" title="Available Instruments" dark />
      <div class="card-grid">
        {instrumentFamilies.map((family) => {
          const liveCount = family.instruments.filter(i => i.status === 'live').length;
          const isClickable = family.status === 'live';
          return (
            <article class={`instrument-card ${isClickable ? 'clickable' : ''}`}>
              <a href={isClickable ? family.href : undefined} class={`instrument-card-header ${isClickable ? 'clickable' : ''}`}>
                <div class="card-meta">
                  <span class="card-id">{family.id}</span>
                  <div class="card-status-group">
                    <span class={`status-badge ${family.status}`}>{family.status}</span>
                  </div>
                </div>
                <h3 class="card-title">{family.title}</h3>
                <p class="card-description">{family.description}</p>
                {family.instruments.length > 0 && (
                  <div class="instrument-stats">
                    <span>INSTRUMENTS: {family.instruments.length}</span>
                    <span>LIVE: {liveCount}</span>
                  </div>
                )}
              </a>

              {family.instruments.length > 0 && (
                <div class="instruments-compact">
                  {family.instruments.map((instrument) => (
                    <a
                      href={instrument.href}
                      class="instrument-compact-row"
                    >
                      <span class="instrument-compact-id">{instrument.id}</span>
                      <span class="instrument-compact-title">{instrument.title}</span>
                      <span class={`status-dot small ${instrument.status}`}></span>
                    </a>
                  ))}
                </div>
              )}

              <a href={isClickable ? family.href : undefined} class={`instrument-card-footer ${!isClickable ? 'disabled' : ''}`}>
                <span>VIEW FAMILY</span>
                <span class="footer-arrow">&rarr;</span>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="section" id="about">
    <div class="container">
      <SectionHeader id="05" title="About" />
    </div>
    <AboutSection />
  </section>

  <!-- Subscribe Section -->
  <section class="section" id="subscribe-section">
    <div class="container">
      <SectionHeader id="06" title="Subscribe" />
    </div>
    <SubscribeSection />
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .empty-state {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--faded);
    text-align: center;
    padding: var(--space-xl);
  }

  /* Instrument Card Styles (Dark Mode) */
  .instrument-card {
    background: var(--card-bg);
    border: 1px solid var(--faded-light-dark);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-default), box-shadow var(--transition-default);
  }

  .instrument-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px rgba(176, 141, 85, 0.3);
  }

  .instrument-card-header {
    padding: 1.5rem;
    text-decoration: none;
    display: block;
    color: inherit;
  }

  .instrument-card-header.clickable {
    cursor: pointer;
  }

  .instrument-card.clickable {
    cursor: pointer;
  }

  .instrument-card .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .instrument-card .card-id {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--gold);
  }

  .status-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--success);
    color: var(--success);
  }

  .status-badge.planned {
    border-color: var(--faded-dark);
    color: var(--faded-dark);
  }

  .instrument-card .card-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.3;
    color: var(--text-light);
    margin-bottom: 0.75rem;
  }

  .instrument-card .card-description {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(242, 240, 233, 0.6);
    margin: 0;
  }

  .instrument-stats {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--faded-dark);
    margin-top: 1.25rem;
    display: flex;
    gap: 1.5rem;
  }

  /* Compact Instruments List */
  .instruments-compact {
    border-top: 1px solid var(--faded-light-dark);
  }

  .instrument-compact-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1.5rem;
    text-decoration: none;
    border-bottom: 1px solid var(--faded-light-dark);
    transition: background var(--transition-fast);
  }

  .instrument-compact-row:last-child {
    border-bottom: none;
  }

  .instrument-compact-row:hover {
    background: rgba(176, 141, 85, 0.15);
    cursor: pointer;
  }

  .instrument-compact-id {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--gold);
    min-width: 60px;
    flex-shrink: 0;
  }

  .instrument-compact-title {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    color: var(--text-light);
    flex: 1;
  }

  .status-dot.small {
    width: 5px;
    height: 5px;
  }

  /* Instrument Card Footer */
  .instrument-card-footer {
    border-top: 1px solid var(--faded-light-dark);
    padding: 0.75rem 1.5rem;
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--gold);
    text-decoration: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color var(--transition-fast);
  }

  .instrument-card-footer:hover {
    color: var(--text-light);
  }

  .instrument-card-footer.disabled {
    color: var(--faded-dark);
    pointer-events: none;
  }

  .footer-arrow {
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .instrument-card-header {
      padding: 1.25rem 1rem;
    }

    .instrument-card .card-title {
      font-size: 1.25rem;
    }

    .instrument-compact-row {
      padding: 0.5rem 1rem;
    }

    .instrument-card-footer {
      padding: 0.6rem 1rem;
    }
  }
</style>
